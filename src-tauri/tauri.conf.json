{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "NetArchitect",
  "version": "../package.json",
  "identifier": "io.github.thespiki.netarchitect",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "NetArchitect : L'Art du Routage",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "SimulationGame",
    "shortDescription": "Jeu de réflexion et de gestion réseau",
    "longDescription": "Conçois, configure et défends le réseau d'entreprises de plus en plus grandes : câblage, VLAN, pare-feu, puis une journée en temps réel face aux pannes et aux attaques.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "languages": ["French", "English"],
        "installMode": "currentUser"
      }
    }
  }
}
